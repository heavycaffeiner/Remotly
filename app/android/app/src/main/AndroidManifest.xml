<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Active SSH shells are kept in a user-visible foreground service while
         the app is backgrounded. The service holds a partial wake lock only
         for the lifetime of a live SSH connection. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- File transfers keep running while the app is backgrounded. dataSync is
         the type Android defines for a transfer the user started. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Key-press feedback in the extra key row. Normal permission, granted
         at install; the terminal's own bell and long press use haptic
         feedback, which needs none. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The camera is optional: the QR scanner is a convenience, and pairing
         always has a manual-entry fallback for devices without a camera. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:networkSecurityConfig="@xml/network_security_config"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="remotly" android:host="pair" />
        </intent-filter>
      </activity>
      <service
        android:name=".ssh.SshSessionService"
        android:exported="false"
        android:stopWithTask="false"
        android:foregroundServiceType="specialUse">
        <!-- Android 14+ requires a human-readable purpose for special-use
             foreground services. This remains visible in the ongoing service
             notification for the lifetime of the user-started SSH shell. -->
        <property
          android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
          android:value="Keeps a user-started SSH terminal session connected while the app is backgrounded." />
      </service>
      <!-- Runs only while a transfer the user started is still moving bytes. -->
      <service
        android:name=".ssh.SftpTransferService"
        android:exported="false"
        android:stopWithTask="false"
        android:foregroundServiceType="dataSync" />
    </application>
</manifest>
