<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon. The launcher masks these two layers to whatever shape the
     device uses, so the glyph is kept well inside the foreground's safe zone
     and the background carries no detail that a mask could cut. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
