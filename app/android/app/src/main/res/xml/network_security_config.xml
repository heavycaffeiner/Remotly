<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is permitted for the Metro bundler dev server (localhost, debug
  builds only in practice). Production network activity is the Go sshcore
  engine's own TCP and SSH handshake, which runs outside Android's HTTP
  stack entirely and is not affected by this policy: SSH negotiates its own
  encryption over the raw socket, so there is no TLS layer here to enforce
  or exempt.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="true" />
</network-security-config>
