<resources>

    <!--
      The window theme only covers the frame around Compose: the background
      behind the first frame, and status and navigation bar handling. Every
      colour the user actually sees comes from the Material 3 Compose theme,
      which reads the platform dynamic palette where there is one.
    -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

</resources>
